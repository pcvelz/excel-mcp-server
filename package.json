{
  "name": "excel-mcp-server-pcvelz",
  "version": "0.16.2",
  "description": "An MCP server that reads and writes spreadsheet data to MS Excel file",
  "author": "pcvelz",
  "license": "MIT",
  "bin": {
    "excel-mcp-server": "dist/launcher.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "PKG_VERSION=$npm_package_version goreleaser build --snapshot --clean && tsc",
    "prepublishOnly": "npm run build && npm run verify-dist",
    "verify-dist": "node scripts/verify-dist-version.js",
    "release-gate": "npm run build && node scripts/release-gate.js",
    "release": "npm run release-gate && npm publish",
    "watch": "tsc --watch",
    "debug": "npx @modelcontextprotocol/inspector dist/launcher.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
